# syntax=docker/dockerfile:1

# The compiled web app. `just demo` loads this image and the chart
# routes https://app.resume.local/ at it. /api stays on the Rust pod.
FROM node:22-bookworm AS build
WORKDIR /src
# Tool installation does not depend on application manifests.
RUN corepack enable && corepack prepare pnpm@10 --activate
COPY web/package.json web/pnpm-lock.yaml ./
RUN --mount=type=cache,id=resume-analyzer-pnpm,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --store-dir /pnpm/store
# Copy only build inputs, not local test reports or generated Vite/Nitro
# state that can alter asset discovery between the client and SSR builds.
COPY web/src ./src
COPY web/vite.config.ts web/tsconfig.json ./
RUN pnpm build

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /src/.output ./.output
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
