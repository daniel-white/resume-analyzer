# syntax=docker/dockerfile:1.7.0@sha256:dbbd5e059e8a07ff7ea6233b213b36aa516b4c53c645f1817a4dd18b83cbea56

# The compiled web app. `just demo` loads this image and the chart
# routes https://app.resume.local/ at it. /api stays on the Rust pod.
# NODEJS_VERSION and PNPM_VERSION are pinned in .node-version and
# web/package.json, and passed by the bake file.
ARG NODEJS_VERSION
ARG PNPM_VERSION

FROM node:${NODEJS_VERSION}-bookworm@sha256:9a2ed90cd91b1f3412affe080b62e69b057ba8661d9844e143a6bbd76a23260f AS build
ARG PNPM_VERSION
WORKDIR /src
# Tool installation does not depend on application manifests.
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY web/package.json web/pnpm-lock.yaml ./
RUN --mount=type=cache,id=resume-analyzer-pnpm,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --store-dir /pnpm/store
# Copy only build inputs, not local test reports or generated Vite/Nitro
# state that can alter asset discovery between the client and SSR builds.
COPY web/src ./src
COPY web/public ./public
COPY web/vite.config.ts web/tsconfig.json ./
COPY scripts/web-assets.mjs ./web-assets.mjs
# The timestamp only affects the build step, so keep it below the install
# layer to avoid invalidating the pnpm store and dependency layer.
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
RUN pnpm build && node web-assets.mjs .output

FROM node:${NODEJS_VERSION}-bookworm-slim@sha256:48abc13a19400ca3985071e287bd405a1d99306770eb81d61202fb6b65cf0b57
ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z
LABEL org.opencontainers.image.source="https://github.com/daniel-white/resume-analyzer" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="MIT"
WORKDIR /app
COPY --from=build --chown=node:node /src/.output ./.output
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000
USER node
CMD ["node", ".output/server/index.mjs"]
